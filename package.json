{
  "name": "keyboardtools",
  "version": "1.1.0",
  "private": true,
  "description": "KeyboardTools keyboard diagnostics for Windows: key test and key-chatter (double keystroke) detection, built with Electron.",
  "keywords": [
    "keyboard",
    "keyboard-test",
    "key-chatter",
    "keyboard-tester",
    "electron"
  ],
  "license": "UNLICENSED",
  "author": "KeyboardTools",
  "repository": {
    "type": "git",
    "url": "https://github.com/quji762/KeyboardTools.git"
  },
  "homepage": "https://github.com/quji762/KeyboardTools",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.keyboardtools.app",
    "productName": "KeyboardTools",
    "copyright": "Copyright © 2026 KeyboardTools",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "assets/**/*",
      "js/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KeyboardTools",
      "artifactName": "KeyboardTools-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "KeyboardTools-${version}-portable.${ext}"
    }
  }
}